<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Appointments & Patients</title>
    <style>
        body {
            padding: 30px;
        }
        h1 {
            margin-bottom: 15px;
        }
        table {
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: left;
        }

    </style>
</head>
<body>
<h1>Appointments & Patients</h1>

<!-- Patient -->
<h2>Patients</h2>
<table>
    <tr>
        <th>Emirates ID</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Ethnicity</th>
    </tr>
    {{#patients}}
        <tr>
            <td>{{emiratesID}}</td>
            <td>{{firstName}}</td>
            <td>{{lastName}}</td>
            <td>{{ethnicity}}</td>
        </tr>
    {{/patients}}
</table>

<!-- Appointments -->
<h2>Appointments</h2>
    <table>
        <tr>
            <th>EmiratesID</th>
            <th>Appointment ID</th>
            <th>Reason</th>
            <th>Doctor ID</th>
            <th>Hospital ID</th>
        </tr>
        {{#appointments}}
            <tr>
                <td>{{emiratesID}}</td>
                <td>{{appointmentID}}</td>
                <td>{{reason}}</td>
                <td>{{doctorID}}</td>
                <td>{{hospitalID}}</td>
            </tr>
        {{/appointments}}
    </table>

<a href="/">Back To Landing Page</a>

</body>
</html>